# Generated by @docs-skills/docs-stale-watcher
# Workspace: {{workspace_ref}}
#
# This workflow listens for `repository_dispatch` events of type
# `docsbook.content.outdated` sent by Docsbook, and opens a GitHub Issue
# per outdated documentation page so the team can triage them.
#
# Payload (client_payload) shape:
#   {
#     "workspace_id":        "<docsbook workspace id>",
#     "page_paths":          ["docs/foo.md", "docs/bar/baz.md", ...],
#     "last_modified_days":  180
#   }

name: Docsbook — stale content handler

on:
  repository_dispatch:
    types: [docsbook.content.outdated]

permissions:
  contents: read
  issues: write

jobs:
  open-stale-issues:
    runs-on: ubuntu-latest
    steps:
      - name: Show payload (debug)
        run: |
          echo "Workspace: ${{ github.event.client_payload.workspace_id }}"
          echo "Threshold (days): ${{ github.event.client_payload.last_modified_days }}"
          echo "Pages: ${{ toJSON(github.event.client_payload.page_paths) }}"

      - name: Open an issue per stale page
        uses: actions/github-script@v7
        env:
          THRESHOLD_DAYS: {{last_modified_days}}
        with:
          script: |
            const payload = context.payload.client_payload || {};
            const pages = Array.isArray(payload.page_paths) ? payload.page_paths : [];
            const thresholdDays = payload.last_modified_days || Number(process.env.THRESHOLD_DAYS) || 180;
            const workspaceId = payload.workspace_id || 'unknown';

            if (pages.length === 0) {
              core.info('No page_paths in payload — nothing to do.');
              return;
            }

            const { owner, repo } = context.repo;
            const labelName = 'docs:stale';

            // Ensure label exists (best-effort).
            try {
              await github.rest.issues.getLabel({ owner, repo, name: labelName });
            } catch (err) {
              if (err.status === 404) {
                await github.rest.issues.createLabel({
                  owner, repo, name: labelName, color: 'fbca04',
                  description: 'Docs page is stale and needs review',
                });
              }
            }

            for (const pagePath of pages) {
              const title = `Docs stale: ${pagePath}`;

              // Skip if an open issue with the same title already exists.
              const existing = await github.rest.search.issuesAndPullRequests({
                q: `repo:${owner}/${repo} is:issue is:open in:title "${title}"`,
              });
              if (existing.data.total_count > 0) {
                core.info(`Skip ${pagePath} — open issue already exists.`);
                continue;
              }

              const blobUrl = `https://github.com/${owner}/${repo}/blob/HEAD/${pagePath}`;
              const body = [
                `Docsbook reports that **\`${pagePath}\`** is stale.`,
                ``,
                `**Why this is stale**`,
                ``,
                `- Page has not been modified in more than **${thresholdDays} days**.`,
                `- Reported by Docsbook workspace \`${workspaceId}\` via the \`content.outdated\` event.`,
                ``,
                `**Suggested actions**`,
                ``,
                `- Re-read the page and verify it still reflects current behavior.`,
                `- Refresh any code samples, screenshots, or version references.`,
                `- If the topic is obsolete, archive or redirect the page.`,
                ``,
                `**Source**`,
                ``,
                `- File: [${pagePath}](${blobUrl})`,
                ``,
                `<sub>Opened automatically by \`docsbook-stale-handler.yml\` (skill: \`docs-stale-watcher\`).</sub>`,
              ].join('\n');

              await github.rest.issues.create({
                owner, repo, title, body, labels: [labelName],
              });
              core.info(`Opened issue for ${pagePath}`);
            }
